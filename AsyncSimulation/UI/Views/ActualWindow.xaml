<UserControl x:Class="AsyncSimulation.UI.Views.ActualWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Code.Bg}">
    <Border Padding="14,12" BorderBrush="{StaticResource Code.Border}" BorderThickness="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="s1 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding S1}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="s2 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding S2}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="s3 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding S3}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="s4 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding S4}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="s5 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding S5}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="s6 ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.Variable}" Padding="0,3"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding S6}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Code.String}" Padding="0,3"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="result ="
                       FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource Code.Function}" Padding="0,3"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Result}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource Code.Function}" Padding="0,3"/>
        </Grid>
    </Border>
</UserControl>
