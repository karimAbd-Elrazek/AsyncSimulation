<UserControl x:Class="AsyncSimulation.UI.Views.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AsyncSimulation.UI.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:CategoryToBrushConverter x:Key="CategoryToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface.Subhead}"
                BorderBrush="{StaticResource Border.Light}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource ColumnHeader}" Padding="14,9,6,9"/>
                <TextBlock Grid.Column="1" Text="WHO"  Style="{StaticResource ColumnHeader}" Padding="6,9"/>
                <TextBlock Grid.Column="2" Text="WHAT JUST HAPPENED" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="STACK (top → bottom)" Style="{StaticResource ColumnHeader}"
                           Foreground="{StaticResource Stack.Accent}"/>
                <TextBlock Grid.Column="4" Text="HEAP (each object: type + fields)" Style="{StaticResource ColumnHeader}"
                           Foreground="{StaticResource Heap.Accent}"/>
            </Grid>
        </Border>

        <!-- ROWS -->
        <ListView ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Padding="0" x:Name="RowList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Time}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                       Foreground="{StaticResource Text.Muted}" Padding="14,4,6,4"
                                       VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="6,4,0,0">
                                <Border Background="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                        CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Text.OnDark}"
                                               FontSize="9" FontWeight="Bold"
                                               FontFamily="{StaticResource Font.Sans}"/>
                                </Border>
                                <TextBlock Text="{Binding ThreadLabel}" Foreground="{StaticResource Text.Subtle}"
                                           FontSize="9" FontFamily="{StaticResource Font.Mono}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                       Foreground="{StaticResource Text.Primary}" FontSize="10.5"
                                       FontFamily="{StaticResource Font.Mono}"
                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                       Padding="8,4"/>

                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Stack}" Padding="8,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Stack.Bg}"
                                                BorderBrush="{StaticResource Stack.Accent}"
                                                BorderThickness="0,0,0,2" CornerRadius="3"
                                                Padding="6,2" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource Stack.Text}"
                                                       FontSize="9" FontFamily="{StaticResource Font.Mono}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Column="4" ItemsSource="{Binding Heap}" Padding="8,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Heap.Bg}" CornerRadius="3"
                                                Padding="6,3" Margin="0,0,4,3" MaxWidth="220">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Heap.Border}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource New.Accent}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="Background" Value="{StaticResource New.Bg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right"
                                                            Background="{StaticResource New.Accent}" CornerRadius="2"
                                                            Padding="3,0" Margin="3,0,0,0"
                                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="NEW" Foreground="{StaticResource Text.OnDark}"
                                                                   FontSize="7" FontWeight="Bold"
                                                                   FontFamily="{StaticResource Font.Sans}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Header}"
                                                               Foreground="{StaticResource Heap.Text}"
                                                               FontSize="9.5" FontWeight="Bold"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="2" Padding="3,1" Margin="0,0,0,1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource Highlight.Bg}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Highlight.Border}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Style="{StaticResource HeapFieldText}">
                                                                    <Run Text="{Binding Display, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
