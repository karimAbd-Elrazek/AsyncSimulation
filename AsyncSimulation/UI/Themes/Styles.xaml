<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Toolbar button (used by Run / Clear) -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Button.Bg}"/>
        <Setter Property="Foreground"      Value="Black"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Sans}"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="Margin"          Value="3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource Button.Border}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Button.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Button.DisabledBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heap-card field text (small monospace) -->
    <Style x:Key="HeapFieldText" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize"     Value="9"/>
        <Setter Property="Foreground"   Value="{StaticResource Heap.FieldText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Column header (TIME / WHO / WHAT / STACK / HEAP) -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Header}"/>
        <Setter Property="Padding"    Value="8,9"/>
    </Style>

    <!-- Code panel — small all-caps label above each block -->
    <Style x:Key="CodePanelLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.OnDark}"/>
        <Setter Property="FontSize"   Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
        <Setter Property="Margin"     Value="0,0,0,6"/>
    </Style>

    <!-- Code panel — monospace line of code -->
    <Style x:Key="CodeLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Code.Default}"/>
    </Style>

</ResourceDictionary>
