<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Font.Sans">Segoe UI</FontFamily>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface.Window"  Color="#F4F4F0"/>
    <SolidColorBrush x:Key="Surface.Card"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Subhead" Color="#FAFAFA"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Border.Default" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Border.Light"   Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Border.Subtle"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Border.Splitter" Color="#DADADB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary"  Color="#1F2937"/>
    <SolidColorBrush x:Key="Text.Muted"    Color="#888888"/>
    <SolidColorBrush x:Key="Text.Subtle"   Color="#999999"/>
    <SolidColorBrush x:Key="Text.Header"   Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Text.Status"   Color="#787878"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="Text.OnDark"   Color="#FFFFFF"/>

    <!-- Stack accent (sky blue) -->
    <SolidColorBrush x:Key="Stack.Accent" Color="#0284C7"/>
    <SolidColorBrush x:Key="Stack.Bg"     Color="#E0F2FE"/>
    <SolidColorBrush x:Key="Stack.Text"   Color="#0C4A6E"/>

    <!-- Heap accent (amber) -->
    <SolidColorBrush x:Key="Heap.Accent"    Color="#D97706"/>
    <SolidColorBrush x:Key="Heap.Border"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="Heap.Bg"        Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Heap.Text"      Color="#78350F"/>
    <SolidColorBrush x:Key="Heap.FieldText" Color="#92400E"/>

    <!-- "NEW" badge (green) -->
    <SolidColorBrush x:Key="New.Accent" Color="#10B981"/>
    <SolidColorBrush x:Key="New.Bg"     Color="#D1FAE5"/>

    <!-- Field-changed highlight (yellow + red border) -->
    <SolidColorBrush x:Key="Highlight.Bg"     Color="#FDE68A"/>
    <SolidColorBrush x:Key="Highlight.Border" Color="#DC2626"/>

    <!-- VS Code dark+ palette for the static code panels -->
    <SolidColorBrush x:Key="Code.Bg"       Color="#1E1E2E"/>
    <SolidColorBrush x:Key="Code.Border"   Color="#2D2D3E"/>
    <SolidColorBrush x:Key="Code.Default"  Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#569CD6"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#9CDCFE"/>
    <SolidColorBrush x:Key="Code.Function" Color="#DCDCAA"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#C586C0"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#4EC9B0"/>
    <SolidColorBrush x:Key="Code.String"   Color="#6A9955"/>

    <!-- Toolbar button -->
    <SolidColorBrush x:Key="Button.Bg"         Color="#ECECEC"/>
    <SolidColorBrush x:Key="Button.Hover"      Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Button.DisabledBg" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Button.Border"     Color="#DCDCDC"/>

</ResourceDictionary>
