<Window x:Class="AsyncSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AsyncSimulation.UI.Converters"
        xmlns:views="clr-namespace:AsyncSimulation.UI.Views"
        mc:Ignorable="d"
        Title="Async/Await Internals Simulator"
        Height="900" Width="1500"
        MinHeight="700" MinWidth="1200"
        Background="{StaticResource Surface.Window}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text.Status}"
                               FontSize="11" FontFamily="{StaticResource Font.Mono}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="RUNNING..." FontWeight="Bold" FontSize="11"
                               FontFamily="{StaticResource Font.Sans}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButton}"
                            Padding="10,5">
                        <TextBlock Text="Clear" FontSize="11"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Async Simulator -- 6 awaits build &quot;FINAL!&quot;"
                               FontSize="14" FontWeight="Bold" Foreground="Black"
                               FontFamily="{StaticResource Font.Sans}" VerticalAlignment="Center"
                               Margin="4,0,14,0"/>
                    <Button Command="{Binding RunDemoCommand}" Style="{StaticResource ToolbarButton}"
                            Padding="12,5" Margin="5,3,3,3">
                        <TextBlock Text="Run" FontWeight="SemiBold" FontSize="11"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY: scene panel | code/virtual-view panel -->
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource Border.Default}"
                          BorderBrush="{StaticResource Border.Splitter}" BorderThickness="1,0"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ShowsPreview="False" Margin="5,0,5,0"/>

            <Border Grid.Column="0" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                    CornerRadius="6" Padding="0">
                <views:SceneView DataContext="{Binding SceneVM}"/>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Background="{StaticResource Surface.Card}" Padding="14,10" CornerRadius="6,6,0,0">
                            <TextBlock Text="Executing Methods" FontWeight="Bold" FontSize="13"
                                       FontFamily="{StaticResource Font.Sans}"/>
                        </Border>

                        <Border Background="{StaticResource Code.Bg}" Padding="14,12"
                                BorderBrush="{StaticResource Code.Border}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="CALLER -- AWAITS THE 6-AWAIT METHOD"
                                           Style="{StaticResource CodePanelLabel}"/>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="async "                Foreground="{StaticResource Code.Keyword}"/><Run Text="void "      Foreground="{StaticResource Code.Keyword}"/><Run Text="OnRunClicked() " Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Text="{}{" Style="{StaticResource CodeLine}"/>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var "    Foreground="{StaticResource Code.Keyword}"/><Run Text="result " Foreground="{StaticResource Code.Variable}"/><Run Text="= "/><Run Text="await "    Foreground="{StaticResource Code.Control}"/><Run Text="BuildFinalWordAsync();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Text="}" Style="{StaticResource CodeLine}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Code.Bg}" Padding="14,12"
                                BorderBrush="{StaticResource Code.Border}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="METHOD WITH 6 AWAITS"
                                           Style="{StaticResource CodePanelLabel}"/>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="async "    Foreground="{StaticResource Code.Keyword}"/><Run Text="MyTask&lt;"  Foreground="{StaticResource Code.Type}"/><Run Text="string"  Foreground="{StaticResource Code.Keyword}"/><Run Text="&gt; "  Foreground="{StaticResource Code.Type}"/><Run Text="BuildFinalWordAsync()" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Text="{}{" Style="{StaticResource CodeLine}"/>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s1" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeF();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s2" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeI();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s3" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeN();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s4" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeA();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s5" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeL();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    var " Foreground="{StaticResource Code.Keyword}"/><Run Text="s6" Foreground="{StaticResource Code.Variable}"/><Run Text=" = "/><Run Text="await " Foreground="{StaticResource Code.Control}"/><Run Text="ComputeBang();" Foreground="{StaticResource Code.Function}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CodeLine}">
                                    <Run Text="    return " Foreground="{StaticResource Code.Control}"/><Run Text="s1 + s2 + s3 + s4 + s5 + s6;"/>
                                </TextBlock>
                                <TextBlock Text="}" Style="{StaticResource CodeLine}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface.Card}" Padding="12,10" CornerRadius="6,6,0,0">
                            <TextBlock Text="Virtual View" FontWeight="Bold" FontSize="13"
                                       FontFamily="{StaticResource Font.Sans}"/>
                        </Border>

                        <views:ActualWindow DataContext="{Binding ActualVM}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
